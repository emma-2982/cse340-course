<%- include('partials/header') %>
<main>
    <h1>
        <%= project.title %>
    </h1>

    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= project.date %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    
    <p>
        <strong>Categories:</strong>
    
        <% categories.forEach((category)=> { %>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
            <% }) %>
   <% if (user && user.role_name==='admin' ) { %>  
    </p>
    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    
      <p>
        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
      </p>
    <% } %>

    <% if (user) { %>
        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
            <button type="submit">Volunteer for this Project</button>
        </form>
        <% } %>


<% if (user) { %>
    <% if (hasVolunteered) { %>
        <form action="/project/<%= project.project_id %>/volunteer/remove" method="POST">
            <button type="submit">
                Remove My Volunteer Signup
            </button>
        </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">
                    Volunteer for this Project
                </button>
            </form>
            <% } %>
                <% } %>


</main>

   

    <%- include('partials/footer') %>