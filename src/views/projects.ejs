<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>

        <ul>
            <% projects.forEach(project=> { %>
        
                <% const today=new Date(); const twoMonthsLater=new Date( today.getFullYear(), today.getMonth() + 2,
                    today.getDate() ); const formattedDate=twoMonthsLater.toLocaleDateString("en-US", { year: "numeric" ,
                    month: "long" , day: "numeric" }); %>
        
                    <li>
                        <strong>
                            <%= formattedDate %>
                        </strong>:
                        <%= project.title %> (<%= project.organization_name %>)
                    </li>
        
                    <% }) %>
        </ul>



    </main>

    <%- include('partials/footer') %>