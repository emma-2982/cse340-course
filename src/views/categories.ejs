<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Service Projects Categories</h2>

        

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>

                    <a href="/edit-category/<%= category.category_id %>">
                        Edit Category
                    </a>
                </li>
                <% }) %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
           <p>
            <a href="/new-category">
                Add New Category
            </a>
           </p>
        <% } %>

        <% if (isLoggedIn) { %>
            <p><a href="/dashboard">My Dashboard</a></p>
            <% } %>
    </main>

    <%- include('partials/footer') %>